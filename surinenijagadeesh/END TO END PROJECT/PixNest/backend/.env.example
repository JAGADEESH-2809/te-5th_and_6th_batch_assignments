# Copy to .env for a local (non-Docker) run. Docker Compose sets these itself.
DATABASE_URL=postgresql+asyncpg://pixnest:pixnest@localhost:5432/pixnest
S3_BUCKET=pixnest-photos
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=ap-south-1
APP_VERSION=dev
ENVIRONMENT=local
JWT_SECRET=local-dev-secret


